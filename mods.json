{
  "disabled": [
    "line-numbers",
    "strip-comments"
  ],
  "settings": {
    "program-header": {
      "label": "Nest Studio usermod",
      "includeStats": true
    },
    "safe-shutdown": {
      "spindleOff": true,
      "coolantOff": true,
      "programEnd": true
    },
    "feed-override": {
      "feedFactor": 1,
      "spindleFactor": 1,
      "minFeed": null,
      "maxFeed": null,
      "maxSpindle": null
    },
    "strip-comments": {
      "keepHeader": true,
      "removeBlankLines": true
    },
    "line-numbers": {
      "start": 10,
      "step": 10,
      "skipComments": true
    },
    "export-copy": {
      "targetDir": "",
      "subfolderByDate": false,
      "overwrite": true
    },
    "dev-shortcuts": {
      "reload": true
    },
    "dark-mode": {
      "followSystem": false
    },
    "arc-fit": {
      "resolutionMm": 0.01,
      "pathTolerancePercent": 0.05,
      "maxRadiusMm": 9999,
      "allow3dArcs": false,
      "minBytes": 2048
    },
    "tool-change-guard": {
      "spindleOff": true,
      "coolantOff": true,
      "retract": true,
      "retractGcode": "G53 G90 G0 Z-1",
      "pause": false,
      "skipFirst": true,
      "treatTAsChange": false
    },
    "job-notifier": {
      "notifyComplete": true,
      "notifyError": true,
      "notifyPause": true,
      "minRunSeconds": 20,
      "settleSeconds": 3,
      "webhookUrl": "",
      "silent": false
    }
  }
}
