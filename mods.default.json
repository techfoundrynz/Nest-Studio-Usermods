{
  "$comment": "Template for mods.json (which is git-ignored and created from this file on first run). Which mods are enabled is chosen inside Nest Studio: MODS menu -> Mods… . Core mods (mods-menu) always load.",
  "enabled": [],
  "settings": {
    "program-header": {
      "label": "Nest Studio usermod",
      "includeStats": true
    },
    "safe-shutdown": {
      "spindleOff": true,
      "coolantOff": true,
      "programEnd": true
    },
    "arc-fit": {
      "resolutionMm": 0.01,
      "pathTolerancePercent": 0.05,
      "maxRadiusMm": 9999,
      "allow3dArcs": false,
      "minBytes": 2048
    },
    "machine-state": {
      "logConsole": false,
      "broadcastMs": 500
    },
    "device-macros": {
      "confirmAll": false,
      "macros": [
        {
          "name": "Safe Z",
          "lines": [
            "G53 G90 G0 Z-1"
          ],
          "confirm": true
        },
        {
          "name": "Spindle off",
          "lines": [
            "M5"
          ],
          "confirm": false
        },
        {
          "name": "Coolant off",
          "lines": [
            "M9"
          ],
          "confirm": false
        },
        {
          "name": "Status",
          "lines": [
            "?"
          ],
          "confirm": false
        }
      ]
    },
    "project-backup": {
      "keep": 20
    },
    "cycles": {
      "safeZ": 5,
      "rpm": 12000
    },
    "peck-drill": {
      "peckDepth": 3,
      "minDepth": 4,
      "retract": "full",
      "partialRetract": 1,
      "clearance": 0.5,
      "dwellSeconds": 0,
      "onlyDrillMoves": true
    },
    "tool-split": {
      "suffix": "-{tool}",
      "minSections": 2,
      "retractGcode": "G53 G90 G0 Z-1",
      "indexComment": true
    },
    "lan-monitor": {
      "port": 9640,
      "host": "0.0.0.0",
      "token": "",
      "camera": "overall"
    },
    "final-geometry": {
      "toleranceMm": 0.1,
      "hideOutside": false,
      "exportStride": 1
    },
    "toolpath-modifiers": {
      "preview": [],
      "camPort": 9630,
      "maxBytes": 67108864
    },
    "jog": {
      "keyboardEnabled": true,
      "keyboardFeed": 1500,
      "keyboardZFeed": 600,
      "keyboardDistance": 200,
      "gamepadMaxFeed": 3000,
      "gamepadZFeed": 800,
      "deadzone": 0.2,
      "invertY": false,
      "stepMs": 100,
      "requireDeviceTab": true
    },
    "gcode-format": {
      "stripComments": false,
      "keepHeader": true,
      "removeBlankLines": true,
      "lineNumbers": false,
      "start": 10,
      "step": 10,
      "skipComments": true
    },
    "jobs": {
      "notifyComplete": true,
      "notifyError": true,
      "notifyPause": true,
      "minRunSeconds": 20,
      "settleSeconds": 3,
      "webhookUrl": "",
      "silent": false,
      "keep": 500,
      "hud": true,
      "hudPosition": "bottom-left",
      "hudWhenDisconnected": true
    },
    "app-tools": {
      "shortcuts": true,
      "reloadShortcut": true
    },
    "mods-menu": {
      "toolbarMaxVisible": 5,
      "toolbarOrder": []
    },
    "bed-size": {
      "enabled": true,
      "travelX": 238,
      "travelY": 200,
      "travelZ": 123,
      "platform": 225
    },
    "feed-scale": {
      "feedFactor": 1,
      "spindleFactor": 1,
      "minFeed": null,
      "maxFeed": null,
      "maxSpindle": null,
      "materials": {}
    },
    "cutter": {
      "scaleLength": true,
      "minLengthScale": 0.6,
      "maxLengthScale": 2.5,
      "hideWhenUnknown": false
    },
    "timelapse": {
      "intervalSeconds": 30,
      "source": "overall",
      "onlyWhileRunning": true,
      "maxFramesPerJob": 2000
    },
    "tool-change": {
      "spindleOff": true,
      "coolantOff": true,
      "retract": true,
      "retractGcode": "G53 G90 G0 Z-1",
      "pause": false,
      "skipFirst": true,
      "treatTAsChange": false,
      "resumeCommand": "~",
      "windowLines": 3
    },
    "export": {
      "keep": 50,
      "stockThickness": null,
      "useHeaderStock": true,
      "allowanceBelow": 0.5,
      "safeZ": 2,
      "checkRapids": true,
      "xMin": null,
      "xMax": null,
      "yMin": null,
      "yMax": null,
      "copyTo": "",
      "copySubfolderByDate": false,
      "copyOverwrite": true,
      "template": "{name}",
      "saveDir": ""
    },
    "work-zero": {
      "positions": [],
      "travelRetract": "G53 G90 G0 Z-1",
      "confirmGoTo": true,
      "plateThickness": 10,
      "probeFeed": 100,
      "fastFeed": 300,
      "twoStage": true,
      "maxTravel": 30,
      "retract": 5,
      "timeoutSeconds": 60,
      "offerAtToolChange": true
    },
    "view": {
      "fovDegrees": 6,
      "mode": "depth",
      "highlight": true
    },
    "appearance": {
      "followSystem": false,
      "zoom": 1,
      "compact": false
    },
    "feeds-speeds": {
      "maxRpm": 24000,
      "favourites": []
    }
  }
}
