{
  "$comment": "Template for mods.json (which is git-ignored and created from this file on first run). Which mods are enabled is chosen inside Nest Studio: MODS menu -> Mods… . Core mods (mods-menu) always load.",
  "enabled": [],
  "settings": {
    "program-header": {
      "label": "Nest Studio usermod",
      "includeStats": true
    },
    "safe-shutdown": {
      "spindleOff": true,
      "coolantOff": true,
      "programEnd": true
    },
    "feed-override": {
      "feedFactor": 1,
      "spindleFactor": 1,
      "minFeed": null,
      "maxFeed": null,
      "maxSpindle": null,
      "materials": {}
    },
    "strip-comments": {
      "keepHeader": true,
      "removeBlankLines": true
    },
    "line-numbers": {
      "start": 10,
      "step": 10,
      "skipComments": true
    },
    "export-copy": {
      "targetDir": "",
      "subfolderByDate": false,
      "overwrite": true
    },
    "dev-shortcuts": {
      "reload": true
    },
    "dark-mode": {
      "followSystem": false
    },
    "arc-fit": {
      "resolutionMm": 0.01,
      "pathTolerancePercent": 0.05,
      "maxRadiusMm": 9999,
      "allow3dArcs": false,
      "minBytes": 2048
    },
    "tool-change-guard": {
      "spindleOff": true,
      "coolantOff": true,
      "retract": true,
      "retractGcode": "G53 G90 G0 Z-1",
      "pause": false,
      "skipFirst": true,
      "treatTAsChange": false
    },
    "job-notifier": {
      "notifyComplete": true,
      "notifyError": true,
      "notifyPause": true,
      "minRunSeconds": 20,
      "settleSeconds": 3,
      "webhookUrl": "",
      "silent": false
    },
    "ui-scale": {
      "zoom": 1,
      "compact": false
    },
    "iso-view": {
      "fovDegrees": 6
    },
    "machine-state": {
      "logConsole": false,
      "broadcastMs": 500
    },
    "status-hud": {
      "position": "bottom-left",
      "showWhenDisconnected": false
    },
    "device-macros": {
      "confirmAll": false,
      "macros": [
        {
          "name": "Safe Z",
          "lines": [
            "G53 G90 G0 Z-1"
          ],
          "confirm": true
        },
        {
          "name": "Spindle off",
          "lines": [
            "M5"
          ],
          "confirm": false
        },
        {
          "name": "Coolant off",
          "lines": [
            "M9"
          ],
          "confirm": false
        },
        {
          "name": "Status",
          "lines": [
            "?"
          ],
          "confirm": false
        }
      ]
    },
    "tool-change-assistant": {
      "resumeCommand": "~",
      "windowLines": 3
    },
    "camera-timelapse": {
      "intervalSeconds": 30,
      "source": "overall",
      "onlyWhileRunning": true,
      "maxFramesPerJob": 2000
    },
    "project-backup": {
      "keep": 20
    },
    "export-filename": {
      "template": "{name}",
      "targetDir": ""
    },
    "export-report": {
      "keep": 50
    },
    "keyboard-jog": {
      "feed": 1500,
      "zFeed": 600,
      "distance": 200,
      "requireDeviceTab": true
    }
  }
}
