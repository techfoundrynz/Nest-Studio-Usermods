{
  "name": "@neststudio-mods/pcb-import",
  "version": "0.3.0",
  "private": true,
  "license": "GPL-3.0-only",
  "usermod": {
    "name": "pcb-import",
    "main": "dist/main.js",
    "ui": "dist/ui.js",
    "order": 100,
    "description": "Import Gerber ZIP packages or layers as separate PCB models with outline, copper relief and drill holes"
  },
  "scripts": {
    "build": "tsc -p tsconfig.main.json && tsc -p tsconfig.ui.json",
    "test": "node --test tests/*.test.cjs",
    "watch": "concurrently \"tsc -p tsconfig.main.json -w\" \"tsc -p tsconfig.ui.json -w\""
  },
  "dependencies": {
    "fflate": "catalog:",
    "gerber-parser": "catalog:",
    "gerber-plotter": "catalog:",
    "clipper-lib": "catalog:",
    "earcut": "catalog:"
  },
  "devDependencies": {
    "@neststudio-usermods/types": "workspace:*"
  }
}
